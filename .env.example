# Copy this file to .env and fill in ONE of the two options. Never commit .env.

# Option 1 (recommended): use your Claude subscription (Pro / Max / Team / Enterprise).
# On your PC run:   claude setup-token
# It opens your browser and prints a token that starts with sk-ant-oat01-. Paste it here:
CLAUDE_CODE_OAUTH_TOKEN=

# Option 2: pay-as-you-go API key from https://console.anthropic.com (only if option 1 doesn't work for you).
# If you use this, delete the CLAUDE_CODE_OAUTH_TOKEN line above and remove the # below.
# ANTHROPIC_API_KEY=
